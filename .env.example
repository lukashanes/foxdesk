# FoxDesk Docker Compose settings. Copy to .env and adjust.
# See docs/DOCKER.md for details.

# --- Web port -------------------------------------------------------------
# Published on 127.0.0.1 only. Put an HTTPS reverse proxy in front for
# public access (FoxDesk redirects plain HTTP to HTTPS for any host name
# other than localhost / 127.0.0.1). Use 0.0.0.0 to listen on all interfaces.
FOXDESK_HTTP_BIND=127.0.0.1
FOXDESK_HTTP_PORT=8080

# --- Database -------------------------------------------------------------
# Enter these values in the web installer (database host: db, port: 3306).
# Required: set both passwords before the first start, for example with
#   openssl rand -hex 24
DB_NAME=foxdesk
DB_USER=foxdesk
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Container time zone (also used by MariaDB for NOW()) -----------------
# The web installer writes this zone into config.php (date_default_timezone_set).
TZ=UTC

# --- Optional -------------------------------------------------------------
# PHP_UPLOAD_MAX_FILESIZE=32M
# PHP_POST_MAX_SIZE=40M
# PHP_MEMORY_LIMIT=256M
# Seconds between background task runs in the cron container (minimum 30).
# FOXDESK_CRON_INTERVAL=60
# Set to 0 to skip the automatic database/files backup taken before the
# container upgrades application files from a newer image.
# FOXDESK_UPGRADE_BACKUP=1
# Image tag used for the locally built image.
# FOXDESK_IMAGE=foxdesk-selfhosted:local
